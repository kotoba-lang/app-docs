{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@types/node"
    ]
  },
  "include": [
    "e2e/**/*.ts"
  ],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}
